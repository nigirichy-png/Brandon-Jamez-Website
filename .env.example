# Public values are bundled into browser code. Never put secrets in NEXT_PUBLIC variables.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
NEXT_PUBLIC_GUIDE_SUPABASE_URL=https://your-guide-project.supabase.co
NEXT_PUBLIC_GUIDE_SUPABASE_ANON_KEY=your-guide-public-anon-key
NEXT_PUBLIC_MAPBOX_TOKEN=your-public-mapbox-token

# Next.js server-only placeholders. Configure real values only in .env.local or
# encrypted deployment settings. Prefer SUPABASE_SECRET_KEY. Set the legacy
# alternative only when the project still issues that key type; both bypass RLS.
SUPABASE_SECRET_KEY=server-only-placeholder
SUPABASE_SERVICE_ROLE_KEY=
VIDEO_PROVIDER=not-configured
VIDEO_PROVIDER_API_TOKEN=server-only-placeholder

# Bunny Stream VOD for large subscriber videos. All values stay server-side.
# The browser receives only a video-scoped TUS signature or an expiring HLS URL.
BUNNY_STREAM_LIBRARY_ID=your-library-id
BUNNY_STREAM_API_KEY=server-only-placeholder
BUNNY_STREAM_READ_ONLY_API_KEY=server-only-placeholder
BUNNY_STREAM_CDN_HOSTNAME=your-cdn-hostname
BUNNY_STREAM_CDN_TOKEN_KEY=server-only-placeholder
BUNNY_STREAM_COLLECTION_ID=
BUNNY_STREAM_TUS_AUTH_TTL_SECONDS=86400
BUNNY_STREAM_PLAYBACK_TOKEN_TTL_SECONDS=7200
STRIPE_SECRET_KEY=sk_test_server-only-placeholder
STRIPE_SUBSCRIPTION_PRICE_ID=price_server-only-placeholder
AGE_VERIFICATION_WEBHOOK_SECRET=server-only-placeholder

# Server-only YouTube moderation connection. The refresh token must carry
# youtube.force-ssl and belong to the channel owner or an appointed moderator.
GOOGLE_CLIENT_ID=server-only-placeholder
GOOGLE_CLIENT_SECRET=server-only-placeholder
YOUTUBE_MODERATION_REFRESH_TOKEN=server-only-placeholder
LIVE_MODERATION_SERVICE_URL=http://127.0.0.1:3011
LIVE_MODERATION_SERVICE_SECRET=server-only-placeholder-at-least-32-characters
LIVE_MODERATION_PORT=3011
LIVE_MODERATION_HOST=127.0.0.1
LIVE_MODERATION_STATE_PATH=.local/youtube-read-rate-limit.json
LIVE_MODERATION_LOCAL_SECRET_PATH=.local/youtube-live-service.key

# Temporary public, read-only Moderation Hub preview. Development enables it
# automatically. Set true for a pre-launch deployment and remove/disable it at launch.
MODERATION_HUB_PUBLIC_PREVIEW_ENABLED=false

# Local-only compatibility fallback: when no explicit refresh token is set,
# services/youtube-live can read the existing encrypted Moderation Hub OAuth state.
YOUTUBE_HUB_ENV_PATH=C:\\Projekte\\Brandon-Moderation-Hub\\.env
YOUTUBE_HUB_TOKEN_STORE_PATH=C:\\Projekte\\Brandon-Moderation-Hub\\.local\\oauth-auth.json

# Supabase Edge Function secret for local Stripe webhook testing. Hosted values
# belong in Supabase Function secrets, not Vercel or browser-visible variables.
STRIPE_WEBHOOK_SECRET=whsec_server-only-placeholder

# Public legal identity and monitored support details. These values are rendered
# on the legal/support pages but remain server configuration rather than browser globals.
LEGAL_OPERATOR_NAME=operator-name-placeholder
LEGAL_ENTITY_TYPE=
LEGAL_REPRESENTATIVE=
LEGAL_STREET_ADDRESS=street-address-placeholder
LEGAL_POSTAL_LOCALITY=postal-code-and-city-placeholder
LEGAL_COUNTRY=country-placeholder
LEGAL_PHONE=telephone-placeholder
LEGAL_REGISTER_NAME=
LEGAL_REGISTER_NUMBER=
LEGAL_VAT_ID=
SUPPORT_EMAIL=support-address-placeholder

# Planned production identity (documentation only until the domain is registered):
# Site: https://brandonjamezofficial.com
# Auth mail: Brandon Jamez <no-reply@auth.brandonjamezofficial.com>
# Auth callbacks: /auth/confirm and /auth/recovery
