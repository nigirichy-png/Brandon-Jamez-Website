# Public values are bundled into browser code. Never put secrets in NEXT_PUBLIC variables.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# Server-only placeholders. Configure real values only in .env.local or deployment settings.
# Prefer the modern server-only secret. The legacy service-role name remains supported.
# Never import either variable into a Client Component; both bypass RLS.
SUPABASE_SECRET_KEY=server-only-placeholder
SUPABASE_SERVICE_ROLE_KEY=server-only-placeholder
VIDEO_PROVIDER=not-configured
VIDEO_PROVIDER_API_TOKEN=server-only-placeholder
STRIPE_SECRET_KEY=sk_test_server-only-placeholder
STRIPE_WEBHOOK_SECRET=whsec_server-only-placeholder
STRIPE_SUBSCRIPTION_PRICE_ID=price_server-only-placeholder
AGE_VERIFICATION_WEBHOOK_SECRET=server-only-placeholder
